[Unit]
Description=Witness gateway recovery and Pod cleanup
After=network-online.target caddy.service
Wants=network-online.target

[Service]
Type=simple
User=witness
Group=caddy
WorkingDirectory=/opt/404-subnet/witness-gateway
Environment=PYTHONPATH=/opt/404-subnet/witness-client/src:/opt/404-subnet/renderer-client/src:/opt/404-subnet/shared
EnvironmentFile=/etc/witness/revivor.env
ExecStart=/opt/404-subnet/.venv/bin/python -m pod_gateway revivor
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/witness

[Install]
WantedBy=multi-user.target
