# Example only. Copy into a private operator-owned file; do not commit real values.
WITNESS_DEPLOYMENT=competition
WITNESS_COMPETITION_REPO=https://github.com/404-Repo/404-active-competition
WITNESS_COMPETITION_BRANCH=main
# Optional read-only token, used only by the gateway.
# WITNESS_GITHUB_TOKEN=REPLACE_WITH_READ_ONLY_GITHUB_TOKEN
WITNESS_ROUND_REFRESH_SECONDS=10
WITNESS_ROUND_POLICY_SECONDS=30
WITNESS_GATEWAY_OWNER_HOTKEY=REPLACE_WITH_CANONICAL_OPERATOR_HOTKEY
WITNESS_GATEWAY_URL=https://witness.example.org
WITNESS_IMAGE=registry.example.org/witness@sha256:REPLACE_WITH_IMAGE_DIGEST
# Optional RunPod registry credential ID for private images.
# WITNESS_REGISTRY=REPLACE_WITH_REGISTRY_CREDENTIAL_ID
WITNESS_MASTER_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_IN_HEX
GATEWAY_RUNPOD_API_KEY=REPLACE_WITH_OPERATOR_RUNPOD_KEY
R2_ENDPOINT=https://REPLACE_WITH_ACCOUNT.r2.cloudflarestorage.com
R2_BUCKET=404-gen
R2_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
SUBTENSOR_RPC_URL=https://REPLACE_WITH_FINNEY_RPC
WITNESS_NETUID=17
# Set this JSON on one line, using the packaged renderer profile and worker image.
WITNESS_RENDERER_PROFILE={"image_digest":"sha256:REPLACE_WITH_IMAGE_DIGEST","validation_sha256":"REPLACE_WITH_RENDERER_PROFILE_SHA256","bootstrap_sha256":null}
DINOV3_REVISION=REPLACE_WITH_EMBEDDING_MODEL_COMMIT
HF_TOKEN=REPLACE_WITH_HUGGING_FACE_TOKEN
# Worker capacity, including pending and draining Pods until deletion is confirmed.
WITNESS_MAX_PODS=250
# Gateway admission and polling bounds.
GATEWAY_CREATE_INTERVAL_SECONDS=10
GATEWAY_REQUEST_INTERVAL_SECONDS=10
GATEWAY_POLL_SECONDS=30
GATEWAY_MAX_REQUESTS=64
GATEWAY_MAX_QUEUE=1024
WITNESS_CPU_ID=cpu3c
WITNESS_VCPU=2
GATEWAY_CPU_ID=cpu3c
GATEWAY_VCPU=4
RUNPOD_MIN_REQUEST_INTERVAL=1.1
WITNESS_IDLE_SECONDS=1800
WITNESS_MAX_CAPTURES=2
GATEWAY_TLS_CERT_B64=REPLACE_WITH_BASE64_GATEWAY_CERTIFICATE_CHAIN
GATEWAY_TLS_KEY_B64=REPLACE_WITH_BASE64_GATEWAY_PRIVATE_KEY
GATEWAY_TLS_CA_FILE=/etc/witness/tls/ca.pem
CADDY_CONFIG_FILE=/var/lib/witness/Caddyfile
# Optional local frontend behind an existing HTTPS tunnel.
# CADDY_LISTEN=http://127.0.0.1:18051
