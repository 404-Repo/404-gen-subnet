{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "404-witness-public-test-membership",
  "account_id": "2e48977c1b68c34717aad2a5e146e866",
  "main": "dist/python/membership.py",
  "base_dir": "dist/python",
  "no_bundle": true,
  "compatibility_date": "2025-10-11",
  "compatibility_flags": ["python_workers", "python_workers_314", "python_dedicated_snapshot"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": {"cpu_ms": 30000},
  "rules": [{"type": "ESModule", "globs": ["**/*.mjs"], "fallthrough": true}],
  "observability": {"enabled": true, "traces": {"enabled": true, "head_sampling_rate": 0.1}},
  "kv_namespaces": [{"binding": "REGISTRY", "id": "7f85f42a64d648ddb3a1eb16ac18edff"}],
  "triggers": {"crons": ["*/10 * * * *"]},
  "vars": {
    "NETWORK": "finney",
    "NETUID": "17",
    "SUBTENSOR_RPC_URL": "https://entrypoint-finney.opentensor.ai"
  }
}
