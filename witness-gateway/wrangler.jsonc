{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "404-witness-public-test",
  "account_id": "2e48977c1b68c34717aad2a5e146e866",
  "main": "dist/gateway/worker.mjs",
  "no_bundle": true,
  "compatibility_date": "2025-10-11",
  "compatibility_flags": [],
  "limits": {"cpu_ms": 30000},
  "secrets": {"required": ["RUNPOD_API_KEY"]},
  "rules": [{"type": "ESModule", "globs": ["**/*.mjs"], "fallthrough": true}],
  "observability": {"enabled": true, "traces": {"enabled": true, "head_sampling_rate": 0.1}},
  "durable_objects": {
    "bindings": [{"name": "MINERS", "class_name": "MinerAdmission"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["MinerAdmission"]}],
  "kv_namespaces": [{"binding": "REGISTRY", "id": "7f85f42a64d648ddb3a1eb16ac18edff"}],
  "r2_buckets": [{"binding": "TRANSCRIPTS", "bucket_name": "404-gen"}],
  "triggers": {"crons": []},
  "vars": {
    "ROUND": "test-0",
    "NETWORK": "finney",
    "NETUID": "17",
    "ROUND_END": "4102444800",
    "RUNPOD_ENDPOINT": "6y1jev9r0zvmw0",
    "MAX_JOBS_PER_MINER": "7680",
    "TEST_HOTKEY": "5D4dcSEVURC69EEWsNLMGwK8EvvYe5djFuR4KZeuHb8q4ztq"
  }
  // RUNPOD_API_KEY is supplied with `wrangler secret put RUNPOD_API_KEY`.
  // Keep test-0 available independently of competition phases.
  // Each signed request still has its own deadline. ROUND_END=0 closes access.
}
