{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "404-witness-python-compat",
  "main": "worker.py",
  "no_bundle": true,
  "compatibility_date": "2025-10-11",
  "compatibility_flags": ["python_workers"],
  "rules": [
    {"type": "ESModule", "globs": ["dist/*.mjs"], "fallthrough": true},
    {"type": "CompiledWasm", "globs": ["dist/*.wasm"], "fallthrough": true}
  ],
  "durable_objects": {"bindings": [{"name": "RELAY", "class_name": "Relay"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Relay"]}]
}
