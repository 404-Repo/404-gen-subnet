# Build from the repository root. This image contains only the miner runtime.
FROM python:3.13-slim-bookworm
COPY renderer-client/src/renderer_client /sdk/renderer_client
COPY witness-client/src/witness_client /sdk/witness_client
COPY witness-client/pyproject.toml /sdk/witness-client.toml
RUN python - <<'PY'
import pathlib, site, subprocess, sys, tomllib
dependencies = tomllib.loads(pathlib.Path("/sdk/witness-client.toml").read_text())["project"]["dependencies"]
dependencies = sorted(value for value in dependencies if not value.startswith("404-"))
subprocess.run([sys.executable, "-m", "pip", "install", "--no-cache-dir", *dependencies, "aiofiles==25.1.0", "loguru==0.7.3", "numpy>=2.2.1", "pillow>=11.1.0"], check=True)
pathlib.Path(site.getsitepackages()[0], "404-sdk.pth").write_text("/sdk\n")
PY
RUN mkdir -p /source /scratch && touch /prompt.png /runner.py
