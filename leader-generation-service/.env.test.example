# Copy to .env in this directory and fill the empty values before startup.
# The gateway follows this existing test branch; leader indexes are published there.
GITHUB_REPO=404-Repo/404-active-competition
GITHUB_BRANCH=witness-test
WITNESS_URL=https://witness-test.subnet404.xyz
CDN_URL=https://subnet404.xyz

# Published generation image pinned as registry/repository@sha256:<64 hex digits>.
GENERATION_IMAGE=

# Supply these privately. GitHub writes must target witness-test.
GITHUB_TOKEN=
RUNPOD_PROVIDER_API_KEY=
# Optional test notification destination.
# DISCORD_WEBHOOK_URL=

# Dedicated test state and subscription login; never share an active Codex login.
STATE_DIRECTORY=/var/lib/404-leader-generation-test
LEADER_CODEX_HOME=/var/lib/404-leader-generation-test/codex
# Provision the existing test hotkey in this wallet:
# 5CAJpeDRXoE9EnsJRsDP1MLKuP31aztpXyPH5JaR49b14P1y
WALLET_PATH=/var/lib/404-leader-generation-test/wallets
WALLET_NAME=leader
WALLET_HOTKEY=default

CPU_ID=cpu3c
VCPUS=8
DISK_GB=20
MAX_HOURLY_COST=0.25
WORKERS=24
PARALLEL_CALLS=32
PARALLEL_PREPARATIONS=4
PROVER_CONTEXTS=4
GO_CPUS=8
GO_MEMORY_MIB=2048
PROGRESS_INTERVAL_SECONDS=1200
STALL_REPLACEMENT_SECONDS=3600
CREDENTIAL_CHECK_INTERVAL_SECONDS=30
LOG_LEVEL=INFO
